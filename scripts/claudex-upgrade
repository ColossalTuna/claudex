#!/usr/bin/env bash
#
# Upgrade the agents in a running container, without root and without a rebuild.
#
# The agents live in /opt/npm-global, which is owned by the runtime user, so
# this works from inside a running container. The upgrade lasts as long as the
# container's writable layer: a restarted container is back to the image's
# version, which is the intended behaviour.
#
# Usage: claudex-upgrade [claude|codex|all]   (default: whichever agent is installed)
#
# Environment:
#   CLAUDEX_CLAUDE_VERSION  npm spec to install (default: latest)
#   CLAUDEX_CODEX_VERSION   npm spec to install (default: latest)
#
# These are deliberately NOT the build arguments CLAUDE_CODE_VERSION and
# CODEX_VERSION, and the build arguments are deliberately not exported into the
# image. They answer different questions: the build argument is what this image
# shipped with, while these are what to move to. Reusing one name for both would
# make `claudex-upgrade` a no-op on any image built with a pinned agent, which
# is precisely the image whose operator is most likely to want a newer agent
# without waiting for a rebuild. What shipped is recorded separately, in
# /opt/npm-global/.claudex-agent-version.
set -euo pipefail

log() { printf 'claudex: %s\n' "$*" >&2; }

target="${1:-auto}"

if [[ ! -w /opt/npm-global ]]; then
  log "/opt/npm-global is not writable by uid $(id -u); cannot upgrade in place."
  exit 1
fi

upgrade_claude() {
  log "upgrading @anthropic-ai/claude-code"
  npm install -g "@anthropic-ai/claude-code@${CLAUDEX_CLAUDE_VERSION:-latest}"
  claude --version
}

upgrade_codex() {
  log "upgrading @openai/codex"
  npm install -g "@openai/codex@${CLAUDEX_CODEX_VERSION:-latest}"
  codex --version
}

case "$target" in
  claude) upgrade_claude ;;
  codex)  upgrade_codex ;;
  all)    upgrade_claude; upgrade_codex ;;
  auto)
    found=0
    command -v claude >/dev/null 2>&1 && { upgrade_claude; found=1; }
    command -v codex  >/dev/null 2>&1 && { upgrade_codex;  found=1; }
    [[ "$found" -eq 1 ]] || { log "no agent found on PATH"; exit 1; }
    ;;
  *)
    log "usage: claudex-upgrade [claude|codex|all]"
    exit 64
    ;;
esac
